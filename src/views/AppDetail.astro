---
import Base from '../layouts/Base.astro';
import AppIcon from '../components/AppIcon.astro';
import { t, localePath, type Lang } from '../i18n/ui';
import { getApps, getPrivacy, stopNumber, type App } from '../lib/apps';

interface Props {
  lang: Lang;
  app: App;
}
const { lang, app } = Astro.props;
const d = app.data;
const apps = await getApps();
const index = apps.findIndex((a) => a.id === app.id);
const next = apps.length > 1 ? apps[(index + 1) % apps.length] : undefined;
const hasPrivacy = Boolean(await getPrivacy(app.id, lang));
const home = localePath(lang, '/');

const info = [
  [t(lang, 'detail.version'), d.version],
  [t(lang, 'detail.updated'), d.updated],
  [t(lang, 'detail.size'), d.size],
  [t(lang, 'detail.languages'), d.languages],
].filter((row): row is [string, string] => Boolean(row[1]));
---
<Base lang={lang} path={`/apps/${app.id}/`} title={d.name} description={d.tagline[lang]}>
  <section class="wrap" style="position:relative;padding-block:48px 32px;display:flex;flex-direction:column;gap:32px">
    <nav aria-label="Breadcrumb" class="crumbs mono">
      <a href={home}>{t(lang, 'detail.breadcrumbHome')}</a><span aria-hidden="true">/</span>
      <a href={`${home}#uygulamalar`}>{t(lang, 'nav.apps')}</a><span aria-hidden="true">/</span>
      <span aria-current="page" style="color:var(--ink)">{t(lang, 'apps.stop')} {stopNumber(index)}</span>
    </nav>
    <div class="app-head glass">
      <AppIcon app={app} size={60} />
      <div class="app-head-copy">
        <div class="tags mono">
          {d.category && <span class="tag">{d.category[lang]}</span>}
          <span class="tag ok">{t(lang, `status.${d.status}`)}</span>
        </div>
        <h1 class="disp">{d.name}</h1>
        <p>{d.summary[lang]}</p>
      </div>
      <div class="play-col">
        <a
          class="play-btn"
          href={d.playUrl ?? '#'}
          rel="noopener"
          aria-disabled={d.playUrl ? undefined : 'true'}
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M6 3.5v17l14-8.5Z"></path></svg>
          <span><small>{d.playUrl ? t(lang, 'detail.free') : t(lang, 'detail.soon')}</small><strong>Google Play</strong></span>
        </a>
        {d.minAndroid && <span>{t(lang, 'detail.android')} {d.minAndroid}+</span>}
      </div>
    </div>
  </section>

  {d.screenshots.length > 0 && (
    <section class="wrap" style="position:relative;padding-block:16px;display:flex;flex-direction:column;gap:24px">
      <span class="mono kicker">{t(lang, 'detail.screens')}</span>
      <div class="shots">
        {d.screenshots.map((src, i) => (
          <div class="shot glass lift">
            <img src={src} alt={`${d.name}: ${t(lang, 'detail.screenshot')} ${i + 1}`} width="220" height="440" loading="lazy" />
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="wrap detail-body" style="position:relative;padding-block:48px 72px">
    <div class="detail-main">
      {d.features.length > 0 && (
        <>
          <h2 class="disp" style="font-size:40px">{t(lang, 'detail.features')}</h2>
          <div class="feature-grid">
            {d.features.map((f, i) => (
              <div class="feature glass lift">
                <div class="feature-head">
                  <span class="feature-num mono">{stopNumber(i)}</span>
                  <h3>{f.title[lang]}</h3>
                </div>
                <p>{f.text[lang]}</p>
              </div>
            ))}
          </div>
        </>
      )}
    </div>
    <aside class="info glass">
      <div class="info-head mono">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--label)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2Z"></path><path d="M9 4v14M15 6v14"></path></svg>
        {t(lang, 'detail.info')}
      </div>
      <dl>
        {info.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
      </dl>
      <div class="info-links">
        {hasPrivacy && <a href={localePath(lang, `/apps/${app.id}/privacy/`)}>{t(lang, 'detail.privacy')}<span aria-hidden="true">→</span></a>}
        {d.supportEmail && <a href={`mailto:${d.supportEmail}?subject=${encodeURIComponent(d.name)}`}>{t(lang, 'detail.support')}<span aria-hidden="true">→</span></a>}
      </div>
    </aside>
  </section>

  <section style="position:relative;padding:0 24px 24px">
    <div class="next-stop glass" style="max-width:1152px;margin:0 auto">
      <div style="display:flex;flex-direction:column;gap:6px">
        <span class="mono kicker" style="font-size:12px">{t(lang, 'detail.next')}</span>
        {next ? (
          <a href={localePath(lang, `/apps/${next.id}/`)} class="disp" style="text-decoration:none">{next.data.name}</a>
        ) : (
          <span class="disp">{t(lang, 'apps.nextText')}</span>
        )}
      </div>
      <a href={`${home}#uygulamalar`} class="btn btn-accent">
        {t(lang, 'detail.all')}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </section>
</Base>
