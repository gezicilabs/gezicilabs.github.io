---
import Base from '../layouts/Base.astro';
import AppCard from '../components/AppCard.astro';
import { t, type Lang } from '../i18n/ui';
import { getApps } from '../lib/apps';
import { site } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const apps = await getApps();
---
<Base lang={lang} path="/">
  <section class="hero">
    <svg class="contours" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <g fill="none" stroke="var(--contour)" stroke-opacity="0.16" stroke-width="1.4">
        <path d="M980 120c120-60 300-40 360 60s20 230-90 290-280 40-360-40-50-250 90-310Z"></path>
        <path d="M1010 170c90-40 220-30 270 45s15 170-65 215-205 30-265-30-40-185 60-230Z"></path>
        <path d="M1045 220c60-25 145-18 178 32s10 112-43 142-135 20-175-20-26-122 40-154Z"></path>
        <path d="M-60 560c140-90 330-110 470-40s180 170 60 230"></path>
        <path d="M-60 510c160-110 380-130 540-50s200 200 70 270"></path>
        <path d="M560 -20c40 80 140 120 240 100s170 10 210 90"></path>
      </g>
    </svg>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <div class="pill glass mono">
          N 41°01′ · E 28°58′ — <span class="only-light">{t(lang, 'hero.camp')}</span><span class="only-dark">{t(lang, 'hero.night')}</span>
        </div>
        <h1 class="disp">{t(lang, 'hero.title1')}<br />{t(lang, 'hero.title2')} <span class="honey">{t(lang, 'hero.title3')}</span></h1>
        <p class="lead">{t(lang, 'hero.lead')}</p>
        <div class="actions">
          <a href="#uygulamalar" class="btn btn-accent">
            {t(lang, 'hero.cta')}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          {site.playDeveloperUrl && <a href={site.playDeveloperUrl} class="btn btn-glass glass" rel="noopener">{t(lang, 'hero.play')}</a>}
        </div>
      </div>

      <div class="phone-wrap" aria-hidden="true">
        <div class="phone glass">
          <div class="phone-screen">
            <svg viewBox="0 0 260 540">
              <g fill="none" stroke="var(--contour)" stroke-opacity="0.22" stroke-width="1.2">
                <path d="M40 120c50-30 120-20 140 25s-10 90-60 100-100-10-110-50 0-60 30-75Z"></path>
                <path d="M60 140c35-18 80-12 92 16s-6 55-38 62-64-6-70-30 0-38 16-48Z"></path>
                <path d="M120 360c60-30 120-10 130 40s-30 90-90 95-110-20-110-60 20-55 70-75Z"></path>
              </g>
              <path class="route" d="M70 470C40 400 200 380 170 300S60 220 110 140" fill="none" stroke="#D98A1E" stroke-width="3" stroke-linecap="round"></path>
            </svg>
            <div class="pin" style="left:92px;top:112px;background:#7FA88B"></div>
            <div class="pin" style="left:152px;top:276px;background:var(--ink)"></div>
            <div class="pin" style="left:54px;top:446px;background:var(--accent)"></div>
          </div>
        </div>
        <div class="chip glass float" style="left:0;top:120px">
          <span class="live-dot"></span>
          <span class="chip-text"><span class="mono">Google Play</span><strong>{apps.length === 0 ? t(lang, 'status.soon') : `${apps.length} ${t(lang, apps.length === 1 ? 'hero.chipCountOne' : 'hero.chipCount')}`}</strong></span>
        </div>
        <div class="chip glass float f2" style="right:0;bottom:110px">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--label)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="m15.5 8.5-2 5-5 2 2-5Z"></path></svg>
          <span class="chip-text"><span class="mono">{t(lang, 'hero.chipNext')}</span><strong>{t(lang, 'hero.chipNextValue')}</strong></span>
        </div>
      </div>
    </div>
  </section>

  <section id="uygulamalar" class="wrap section">
    <div class="section-head">
      <div>
        <span class="mono kicker">{t(lang, 'apps.kicker')}</span>
        <h2 class="disp h2">{t(lang, 'apps.title')}</h2>
      </div>
      <p class="section-lead">{t(lang, 'apps.lead')}</p>
    </div>
    <div class="grid">
      {apps.map((app, i) => <AppCard app={app} index={i} lang={lang} />)}
      <div class="next-card">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"></path><path d="M12 7v5M9.5 9.5h5"></path></svg>
        <div class="disp">{t(lang, 'apps.next')}</div>
        <div>{t(lang, 'apps.nextText')}</div>
      </div>
    </div>
  </section>

  <section id="hakkinda" class="wrap" style="position:relative;padding-block:24px 96px">
    <div class="panel glass">
      <div>
        <span class="mono kicker">{t(lang, 'about.kicker')}</span>
        <h2 class="disp h2">{t(lang, 'about.title')}</h2>
      </div>
      <div class="prose-lg">
        <p>{t(lang, 'about.p1')}</p>
        <p>{t(lang, 'about.p2')}</p>
      </div>
    </div>
  </section>
</Base>
